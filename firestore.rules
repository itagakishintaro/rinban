rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /groups/{groupId} {
      function isValidGroup(d) {
        return d.keys().hasOnly(['name', 'members', 'order', 'rotation', 'overrides', 'endDate', 'archived', 'createdAt', 'updatedAt'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 50
          && d.members is list && d.members.size() <= 50
          && d.order is list
          && d.overrides is map
          && (!('endDate' in d) || d.endDate is string)
          && (!('archived' in d) || d.archived is bool);
      }

      // URLを知っている(=groupIdを知っている)人は誰でも読み書き可
      allow get: if true;
      // グループIDの列挙を防ぐ
      allow list: if false;
      allow create, update: if isValidGroup(request.resource.data);
      // 誤削除・荒らし防止
      allow delete: if false;
    }
  }
}
